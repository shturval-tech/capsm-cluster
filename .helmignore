# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*.log
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
values-test.yaml
values-test*
conf/stc
backup-*
__pycache__/
*.pyc
*.pyo
prepare-*.log